[user-account]
;配置账号密码，留空则打开网页后需手动登录
username =
password =

[browser-option]
;macOS 默认启动独立 Chrome，EXE_PATH 通常留空
driver = Chrome
EXE_PATH =
;实验性：连接已开启远程调试的日常 Chrome
attachExistingChrome = False
cdpUrl = http://127.0.0.1:9224

[script-option]
;自动滑块只支持登录页，课中安全验证仍需手动完成
enableAutoCaptcha = False
enableHideWindow = False

[course-option]
;限制每门课程运行时长/min (不限制:0)
limitMaxTime = 30
;播放倍速。max = 切到播放器倍速菜单里最高的一档(推荐)
;也可以填具体数字, 那样会取菜单里不超过它的最高一档; 填 0 则完全不碰倍速。
;只会用菜单里列出来的档位——那才是平台允许的。实测这个播放器提供 1.0 / 1.25 / 1.5
limitSpeed = max
soundOff = True

[course-url]
;要学习的课程播放页地址(能直接看到视频的那一页),可继续添加多个
;全部留空也行: 运行后在打开的浏览器里自己点开一门课, 会自动开始
URL1 =
URL2 =
URL3 =
URL4 =
URLn =
