{
  "name": "yuketang-browser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "用真实浏览器学习长江雨课堂「学习空间」里的视频和图文",
  "scripts": {
    "start": "node run.mjs",
    "check": "node run.mjs --check",
    "inspect": "node run.mjs --inspect",
    "test": "node --test --test-timeout=180000 tests/unit.test.mjs tests/e2e.test.mjs",
    "test:unit": "node --test tests/unit.test.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  }
}
