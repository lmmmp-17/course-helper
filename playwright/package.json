{
  "name": "xuexitong-playwright",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "用真实输入事件驱动学习通课程播放的 Playwright 版本",
  "scripts": {
    "start": "node run.mjs",
    "check": "node run.mjs --check",
